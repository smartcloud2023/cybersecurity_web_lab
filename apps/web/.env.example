# Only needed when running `npm run dev` directly against a separately
# running API (e.g. `uvicorn app.main:app --reload` on :8000). Next.js reads
# NEXT_PUBLIC_* vars from .env.local at dev-server start, unlike the Docker
# build where it's a build arg — see apps/web/Dockerfile.
NEXT_PUBLIC_API_URL=http://localhost:8000
