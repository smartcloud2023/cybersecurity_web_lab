DATABASE_URL=postgresql+psycopg://cyberlab:cyberlab@localhost:5432/cyberlab
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in any non-local environment — tokens signed with a guessed or
# default key let an attacker forge auth for any account.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated. Only matters when the frontend and API are on different
# origins (e.g. docker-compose.local.yml) — behind the nginx compose base
# they share an origin and CORS never triggers.
CORS_ORIGINS=http://localhost:3000

# Optional. Without these, verification-email codes are only logged to the
# API's own console (fine for local/dev, not real delivery) — see
# app/core/email.py. Any SMTP provider works; two quick options:
#
#   Gmail (fastest way to test with your own address): create an App
#   Password at https://myaccount.google.com/apppasswords (requires 2FA on
#   the Google account), then:
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USERNAME=your.address@gmail.com
#     SMTP_PASSWORD=<the 16-character app password>
#     SMTP_FROM_EMAIL=your.address@gmail.com
#
#   Amazon SES (matches the blueprint's AWS choice, for production): verify
#   a sending domain/address in SES, create SMTP credentials under
#   SES > SMTP Settings, then:
#     SMTP_HOST=email-smtp.<region>.amazonaws.com
#     SMTP_PORT=587
#     SMTP_USERNAME=<SES SMTP username>
#     SMTP_PASSWORD=<SES SMTP password>
#     SMTP_FROM_EMAIL=<a verified SES sender address>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@cyberlab.local
