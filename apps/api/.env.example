DATABASE_URL=postgresql+psycopg://cyberlab:cyberlab@localhost:5432/cyberlab
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in any non-local environment — tokens signed with a guessed or
# default key let an attacker forge auth for any account.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated. Only matters when the frontend and API are on different
# origins (e.g. docker-compose.local.yml) — behind the nginx compose base
# they share an origin and CORS never triggers.
CORS_ORIGINS=http://localhost:3000
